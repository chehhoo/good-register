#!/bin/bash
# post-commit: bump version in package.json based on conventional commit type,
# amend the commit, then tag it with the new version.
#
# Bump rules (Conventional Commits):
#   feat!: / BREAKING CHANGE  → major  (x.0.0)
#   feat:                     → minor  (0.x.0)
#   everything else           → patch  (0.0.x)

TAG_SENTINEL=".git/TAG_AFTER_AMEND"
BUMP_SENTINEL=".git/BUMP_IN_PROGRESS"

# Second invocation (after --amend): apply the tag then exit.
if [ -f "$TAG_SENTINEL" ]; then
    NEW=$(cat "$TAG_SENTINEL")
    rm -f "$TAG_SENTINEL"
    git tag -f "v$NEW"
    echo "post-commit: tagged v$NEW"
    exit 0
fi

# Guard against any other recursion.
if [ -f "$BUMP_SENTINEL" ]; then
    rm -f "$BUMP_SENTINEL"
    exit 0
fi

PKG="package.json"

MSG=$(git log -1 --pretty=%s)

# Determine bump type
if echo "$MSG" | grep -qE "!:|BREAKING CHANGE"; then
    BUMP="major"
elif echo "$MSG" | grep -qE "^feat(\(.+\))?:"; then
    BUMP="minor"
else
    BUMP="patch"
fi

# Read current version from package.json
CURRENT=$(grep '"version"' "$PKG" | head -1 | sed 's/.*"version": "\([^"]*\)".*/\1/')

if [ -z "$CURRENT" ]; then
    echo "post-commit: could not read version, skipping bump"
    exit 0
fi

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"

case "$BUMP" in
    major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
    minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
    patch) PATCH=$((PATCH + 1)) ;;
esac

NEW="$MAJOR.$MINOR.$PATCH"
echo "post-commit: $BUMP bump  $CURRENT → $NEW"

# Update package.json
sed -i "s/\"version\": \"$CURRENT\"/\"version\": \"$NEW\"/" "$PKG"

# Write new version to TAG_SENTINEL so the next invocation can tag it.
echo "$NEW" > "$TAG_SENTINEL"
touch "$BUMP_SENTINEL"

git add "$PKG"
git commit --amend --no-edit
